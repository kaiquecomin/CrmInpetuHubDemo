# Database connection; DB_PASSWORD is mandatory.
DB_URL=
DB_USER=
DB_PASSWORD=
JWT_SECRET=
OTP_SECRET=
APP_RATE_LIMIT_SECRET=
APP_PUBLIC_URL=

# Brevo transactional emails
MAIL_ENABLED=false
BREVO_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=

# Set both only when bootstrapping the first production coordinator.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Required by the local demo profile.
APP_DEMO_ADMIN_EMAIL=admin@inpetu.test
DEMO_ADMIN_PASSWORD=

# Legacy external test-database credential. The application no longer selects
# a second database, so this value is not consumed by the current code.
DB_TEST_PASSWORD=

# Comma-separated frontend origin(s), never use a wildcard with credentials.
FRONTEND_ORIGIN=

# Only set after confirming stable trusted proxy source IPs; exact IPs, no CIDRs.
TRUSTED_PROXIES=

# Somente local: ativa a funcionalidade experimental do Mural.
# MURAL_ENABLED=true
