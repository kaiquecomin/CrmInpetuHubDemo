# Database connection; DB_PASSWORD is mandatory.
DB_URL=
DB_USER=
DB_PASSWORD=
JWT_SECRET=

# Set both only when bootstrapping the first production coordinator.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Required by the local demo profile.
DEMO_ADMIN_PASSWORD=

# Legacy external test-database credential. The application no longer selects
# a second database, so this value is not consumed by the current code.
DB_TEST_PASSWORD=

# Comma-separated frontend origin(s), never use a wildcard with credentials.
FRONTEND_ORIGIN=
